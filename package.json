{
  "name": "id-dom",
  "version": "0.0.9",
  "description": "Deterministic DOM element getters by ID (typed, tiny, modern).",
  "author": "WATT3D <WATT3D@protonmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/id-dom.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/id-dom.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/id-dom.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./min": {
      "types": "./dist/types/id-dom.d.ts",
      "import": "./dist/index.min.js",
      "default": "./dist/index.min.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ADDITIONAL_TERMS.md",
    "robots.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iWhatty/id-dom.git"
  },
  "bugs": {
    "url": "https://github.com/iWhatty/id-dom/issues"
  },
  "homepage": "https://github.com/iWhatty/id-dom#readme",
  "keywords": [
    "dom",
    "getelementbyid",
    "typed-dom",
    "html",
    "vanilla-js",
    "browser",
    "shadow-dom",
    "utilities"
  ],
  "scripts": {
    "build": "node build.js",
    "build:types": "tsc -p tsconfig.types.json && node -e \"require('node:fs').copyFileSync('dist/types/id-dom.d.ts', 'dist/types/id-dom.d.cts')\"",
    "prepublishOnly": "npm run build && npm run build:types && npm test",
    "test": "npm run build && vitest run --environment jsdom && npm run test:types",
    "test:types": "npm run build:types && tsc -p test/types/tsconfig.json && tsc -p test/types/tsconfig.loose.json && tsc -p test/types/node16/tsconfig.json",
    "test:watch": "vitest --environment jsdom"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
